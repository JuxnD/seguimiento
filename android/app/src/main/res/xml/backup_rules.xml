<?xml version="1.0" encoding="utf-8"?>
<!-- Android <=30; manual ZIP/local backups remain separate. -->
<!-- device_* are valid Android domains per developer.android.com/identity/data/autobackup.
     Fixed AGP lint omits them from its enum: suppress only that false alert. -->
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." tools:ignore="FullBackupContent" />
    <exclude domain="device_file" path="." tools:ignore="FullBackupContent" />
    <exclude domain="device_database" path="." tools:ignore="FullBackupContent" />
    <exclude domain="device_sharedpref" path="." tools:ignore="FullBackupContent" />
</full-backup-content>
